# env files — commit `.env.example` only; copy to `.env.local`, `.env.prod`, `.env.uat`, etc.
.env*
!.env.example
.env.sentry-build-plugin

# local Docker Compose overrides
docker-compose.override.yml

# local logs
*.log

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# storybook
/storybook-static/
debug-storybook.log
*storybook.log

# mkcert dev certificates, generated by `pnpm dev` (scripts/dev.mjs runs https)
certificates

