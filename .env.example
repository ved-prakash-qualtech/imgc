# App
APP_URL=https://localhost:3000
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_APP_NAME=QCP App
NEXT_PUBLIC_APP_VERSION=0.0.1

# Local development server
#
# HTTPS is the default and should stay that way: the session cookies are Secure, and a browser
# silently discards a Secure cookie delivered over http — sign-in then loops with nothing logged.
# mkcert's root CA is installed on first `pnpm dev`, which needs an interactive terminal once.
#
# Scope comes from the hostname, so testing tenant scope means running on a tenant host rather
# than on localhost. Point it at 127.0.0.1 in the hosts file and set DEV_HOSTNAME — Next also
# needs it to stop treating its own dev resources as cross-origin (see next.config.ts).
# DEV_HTTPS=true
# DEV_HOSTNAME=at1-app-local.qualtechedge.in
# DEV_OPEN_BROWSER=true

# Optional public API defaults (validated by env singleton; backends still use getServerEnv)
# NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api
# NEXT_PUBLIC_API_TIMEOUT_MS=30000
# NEXT_PUBLIC_JWT_AUTH_ENABLED=false

# Build / observability
# ANALYZE=false
# NEXT_SOURCE_MAPS_ENABLED=true
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
# SENTRY_TRACES_SAMPLE_RATE=
# SENTRY_DEBUG=false

# Backend (server-only — see getServerEnv)
# BACKEND_BASE_URL=http://localhost:8080
# SUPER_ADMIN_URL=http://localhost:8080
# API_CLIENT_ID=
# API_CLIENT_SECRET=

# Vault (optional)
# VAULT_ADDR=
# VAULT_ROLE_ID=
# VAULT_SECRET_ID=
# VAULT_SECRET_PATH=

# ENCRYPTION_MASTER_KEY=
