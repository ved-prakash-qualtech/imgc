{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.cache/tsconfig.root.tsbuildinfo",
    "paths": {
      "sonner": ["./packages/lib/sonner.tsx"],
      "@/*": ["./storybook/*"]
    }
  },
  "include": [
    "tooling/next-env.d.ts",
    "tooling/**/*.ts",
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "test/**/*.ts",
    "test/**/*.tsx",
    "storybook/**/*.ts",
    "storybook/**/*.tsx",
    "vitest*.ts",
    "vitest*.d.ts"
  ],
  "exclude": ["node_modules", "**/node_modules"]
}
